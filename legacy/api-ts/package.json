{
  "name": "device-inventory-api-ts",
  "version": "2.0.0",
  "description": "TypeScript API service for Device Inventory with unified schema normalization",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --L --watch src --ext ts --exec bun run src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "create-license-index": "bun run scripts/create-license-index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.1",
    "@ai-sdk/google": "^3.0.1",
    "@ai-sdk/openai": "^3.0.1",
    "@opensearch-project/opensearch": "^2.5.0",
    "@types/cron": "^2.4.3",
    "ai": "^6.0.3",
    "bcrypt": "^6.0.0",
    "chokidar": "3.6.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.2",
    "node-forge": "^1.3.1",
    "nodemon": "^3.1.11",
    "rate-limit-redis": "^4.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "winston-transport": "^4.9.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "bun-types": "latest",
    "typescript": "^5.3.3"
  }
}
